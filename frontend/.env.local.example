# ══════════════════════════════════════════════════════════════════════
#  ConnectBarcodes Frontend — Environment Variables
#  Copy this file to .env.local — never commit .env.local to git
# ══════════════════════════════════════════════════════════════════════

# ── Medusa Backend ────────────────────────────────────────────────────
# Local dev: point to your local backend
NEXT_PUBLIC_MEDUSA_BACKEND_URL=http://localhost:9000
# Production: https://connect-barcodes-production.up.railway.app

# Publishable key — get from Medusa Admin → Settings → API Keys
NEXT_PUBLIC_MEDUSA_PUBLISHABLE_KEY=pk_f90e01a551c291ea8e59dc37d0e668b074bf3f8003212d5048abe50985302e91

# Server-side backend URL (used in Next.js API routes)
MEDUSA_BACKEND_URL=http://localhost:9000
# Production: https://connect-barcodes-production.up.railway.app

# ── Stripe ────────────────────────────────────────────────────────────
# Publishable key (safe to expose — used in browser)
# Get from https://dashboard.stripe.com/apikeys
NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY=pk_test_51Qc38IF7WiRsMsPeCiWmC5j1Ulh871QeXSkSq6y0f0MpfoCcqu1qqy7OcWjFcfp5a7QrBMViqRR5L8uXslfBuz9600emOFIhYd

# Secret key (server-side only — never expose in browser)
# REQUIRED — get from project owner or Stripe Dashboard
STRIPE_SECRET_KEY=sk_test_XXXX

# ── Algolia ───────────────────────────────────────────────────────────
# Search-only keys — safe to expose in browser
NEXT_PUBLIC_ALGOLIA_APP_ID=20C3UUXFBH
NEXT_PUBLIC_ALGOLIA_SEARCH_KEY=8923367d006a5d2aa01f45a3485b47e8
NEXT_PUBLIC_ALGOLIA_INDEX_NAME=connect_barcodes_products

# ── Admin Auth ────────────────────────────────────────────────────────
# REQUIRED — generate with: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
NEXTAUTH_SECRET=GENERATE_A_STRONG_RANDOM_SECRET
# Set to your local URL for dev, production URL for prod
NEXTAUTH_URL=http://localhost:3000

# ── Node ──────────────────────────────────────────────────────────────
NODE_ENV=development
