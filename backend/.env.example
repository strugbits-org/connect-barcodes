# ══════════════════════════════════════════════════════════════════════
#  ConnectBarcodes Backend — Environment Variables
#  Copy this file to .env and fill in the values marked REQUIRED
# ══════════════════════════════════════════════════════════════════════

# ── Database ──────────────────────────────────────────────────────────
# REQUIRED — PostgreSQL connection string
# Local dev: postgresql://postgres:password@localhost:5432/connect_barcodes
# Production: get from Railway → postgres service → Variables → DATABASE_URL
DATABASE_URL=postgresql://USER:PASSWORD@HOST:PORT/DATABASE

# ── Redis ─────────────────────────────────────────────────────────────
# REQUIRED — Redis connection string
# Local dev: redis://localhost:6379
# Production: get from Railway → redis service → Variables → REDIS_URL
REDIS_URL=redis://localhost:6379

# ── JWT & Cookie Secrets ──────────────────────────────────────────────
# REQUIRED — generate with: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
JWT_SECRET=GENERATE_A_STRONG_RANDOM_SECRET
COOKIE_SECRET=GENERATE_A_DIFFERENT_STRONG_RANDOM_SECRET

# ── Stripe ────────────────────────────────────────────────────────────
# REQUIRED — get from https://dashboard.stripe.com/apikeys
# Use test keys (sk_test_...) for local dev
STRIPE_SECRET_KEY=sk_test_XXXX
# REQUIRED — get from Stripe Dashboard → Webhooks → your endpoint → Signing secret
STRIPE_WEBHOOK_SECRET=whsec_XXXX

# ── Algolia ───────────────────────────────────────────────────────────
# App ID is shared — same for everyone on the project
ALGOLIA_APP_ID=20C3UUXFBH
# REQUIRED — Admin API key: get from project owner (never commit the real key)
ALGOLIA_ADMIN_API_KEY=GET_FROM_PROJECT_OWNER
ALGOLIA_SEARCH_API_KEY=8923367d006a5d2aa01f45a3485b47e8
ALGOLIA_INDEX_NAME=connect_barcodes_products

# ── CORS / URLs ────────────────────────────────────────────────────────
# Local dev — keep as localhost
BACKEND_URL=http://localhost:9000
STORE_CORS=http://localhost:3000
ADMIN_CORS=http://localhost:3000
AUTH_CORS=http://localhost:3000

# Production values (set these in Railway, not here):
# BACKEND_URL=https://connect-barcodes-production.up.railway.app
# STORE_CORS=https://connect-barcodes-frontend.vercel.app
# ADMIN_CORS=https://connect-barcodes-frontend.vercel.app
# AUTH_CORS=https://connect-barcodes-frontend.vercel.app

# ── Node ──────────────────────────────────────────────────────────────
NODE_ENV=development
PORT=9000
